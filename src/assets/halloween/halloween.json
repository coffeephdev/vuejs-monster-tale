{"lines":{"1":{"character":"","next_id":"2","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"100":{"mutation":{"lhs_args":["\"\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"101","type":"mutation"},"101":{"next_id":"104","type":"goto"},"104":{"character":"","next_id":"","replacements":[],"text":"oh bah di dont les embrouillaminis","type":"dialogue"},"12":{"condition":{"lhs":"hasCheckCauldron","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"29","next_id":"13","next_id_after":"29","type":"condition"},"13":{"character":"","next_id":"14","replacements":[],"text":"Peut-être qu'il faudrait y aller maintenant...","type":"dialogue"},"14":{"condition":null,"next_id":"15","next_id_after":"30","replacements":[],"responses":["14","27"],"text":"Relire la recette","type":"response"},"15":{"mutation":{"lhs_args":["\"hasReadRecipy\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"16","type":"mutation"},"16":{"character":"Léonnie","next_id":"17","replacements":[],"text":"Je l'ai mise quelque part...","type":"dialogue"},"17":{"character":"","next_id":"18","replacements":[],"text":"Léonnie n'est pas très organisée","type":"dialogue"},"18":{"character":"Léonnie","next_id":"19","replacements":[],"text":"Dis-donc ! Ca suffit ! Alors...","type":"dialogue"},"19":{"character":"Léonnie","next_id":"20","replacements":[],"text":"La recette de ma fameuse potion revigorante pour citrouille !","type":"dialogue"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"character":"Léonnie","next_id":"21","replacements":[],"text":"Dans la famille, nous faisons briller les citrouilles de mère en fille depuis des générations !","type":"dialogue"},"21":{"character":"Léonnie","next_id":"22","replacements":[],"text":"Pour qu'elles soient reluisantes et dodues, il nous faut :","type":"dialogue"},"22":{"character":"Léonnie","next_id":"23","replacements":[],"text":"Une peau de renard crevé sous les roues d'un carosse de Maraine-la-bonne-fée. Un peu triste. Au moins, c'est pas perdu...","type":"dialogue"},"23":{"character":"Léonnie","next_id":"24","replacements":[],"text":"...Une fraise. J'aime les fraises. Et puis ça fait briller les cirtrouilles.","type":"dialogue"},"24":{"character":"Léonnie","next_id":"25","replacements":[],"text":"...Un gros triton réduit en poudre. Cueilli moi-même !","type":"dialogue"},"25":{"character":"Léonnie","next_id":"26","replacements":[],"text":"...et une queue de citrouille.","type":"dialogue"},"26":{"next_id":"12","type":"goto"},"27":{"condition":null,"next_id":"28","next_id_after":"30","replacements":[],"responses":[],"text":"Aller voir les citrouilles (pour de vrai)","type":"response"},"28":{"next_id":"53","type":"goto"},"29":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"40","next_id":"30","next_id_after":"","type":"condition"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"character":"","next_id":"31","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"31":{"condition":null,"next_id":"32","next_id_after":"41","replacements":[],"responses":["31","38"],"text":"Vérifier le feu sous le chaudron","type":"response"},"32":{"mutation":{"lhs_args":["\"hasCheckCauldron\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"33","type":"mutation"},"33":{"character":"Léonnie","next_id":"34","replacements":[],"text":"Non, c'est bon j'ai éteins le feu...","type":"dialogue"},"34":{"character":"","next_id":"35","replacements":[],"text":"Léonnie est enthousiasmée, mais peut-être un peu nerveuse","type":"dialogue"},"35":{"character":"Léonnie","next_id":"36","replacements":[],"text":"Mais ?! Mais non, pas du tout !","type":"dialogue"},"36":{"character":"Léonnie","next_id":"37","replacements":[],"text":"Peut-être un peu...","type":"dialogue"},"37":{"next_id":"12","type":"goto"},"38":{"condition":null,"next_id":"39","next_id_after":"41","replacements":[],"responses":[],"text":"Aller voir les citrouilles...?","type":"response"},"39":{"next_id":"53","type":"goto"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"condition":null,"next_conditional_id":"","next_id":"41","next_id_after":"","type":"condition"},"41":{"character":"","next_id":"42","replacements":[],"text":"Mais rien ne presse...","type":"dialogue"},"42":{"condition":null,"next_id":"43","next_id_after":"","replacements":[],"responses":["42","49"],"text":"Boire une lampée","type":"response"},"43":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"44","type":"mutation"},"44":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"45","type":"mutation"},"45":{"character":"","next_id":"46","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"46":{"character":"","next_id":"47","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"47":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"48","type":"mutation"},"48":{"next_id":"12","type":"goto"},"49":{"condition":null,"next_id":"50","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"next_id":"53","type":"goto"},"53":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"54","type":"mutation"},"54":{"character":"","next_id":"55","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"55":{"character":"","next_id":"56","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"56":{"character":"Léonnie","next_id":"57","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"57":{"character":"Léonnie","next_id":"58","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Fantôme","next_id":"60","replacements":[],"text":"Oh là là...","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"character":"Léonnie","next_id":"61","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"61":{"character":"Fantôme","next_id":"62","replacements":[],"text":"Oh... Oh... On est dans de beaux draps...","type":"dialogue"},"62":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"63","type":"mutation"},"63":{"character":"Léonnie","next_id":"64","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"64":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"65","type":"mutation"},"65":{"character":"Fantôme","next_id":"66","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"66":{"character":"Léonnie","next_id":"67","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller...)","type":"dialogue"},"67":{"character":"Léonnie","next_id":"68","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit pour vivre !","type":"dialogue"},"68":{"character":"Léonnie","next_id":"69","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"69":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"70","type":"mutation"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"70":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"71","type":"mutation"},"71":{"character":"Fantôme","next_id":"72","replacements":[],"text":"Très bien, très bien ! Ecoute, ça va te paraitre bizarre...","type":"dialogue"},"72":{"character":"Fantôme","next_id":"73","replacements":[],"text":"Ne te froisse pas... C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"73":{"character":"Léonnie","next_id":"74","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"74":{"character":"Fantôme","next_id":"75","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"75":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"76","type":"mutation"},"76":{"character":"Léonnie","next_id":"77","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"77":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"78","type":"mutation"},"78":{"character":"Fantôme","next_id":"79","replacements":[],"text":"Elles sont allées vers la ville... Je n'ose aller voir...","type":"dialogue"},"79":{"character":"Léonnie","next_id":"80","replacements":[],"text":"Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"80":{"next_id":"83","type":"goto"},"83":{"character":"Léonnie","next_id":"84","replacements":[],"text":"Ca ne peut pas être ma potion, je la concocte chaque année...","type":"dialogue"},"84":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","rhs_type":""},"next_id":"85","next_id_after":"90","replacements":[],"responses":["84","89"],"text":"Réfléchir très fort","type":"response"},"85":{"character":"Léonnie","next_id":"86","replacements":[],"text":"Mmh... C'est vrai que la tisane avait un arrière-goût...","type":"dialogue"},"86":{"character":"Léonnie","next_id":"87","replacements":[],"text":"C'était donc ça, le goût intense ? Je me demande...","type":"dialogue"},"87":{"character":"","next_id":"88","replacements":[],"text":"Tout à ses réflexions, Léonnie se met en route en direction de Toussaint-Sainte-Peur.","type":"dialogue"},"88":{"next_id":"94","type":"goto"},"89":{"condition":null,"next_id":"90","next_id_after":"90","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"9":{"next_id":"12","type":"goto"},"90":{"character":"","next_id":"91","replacements":[],"text":"En proie au doute sur ses compétences, Léonnie file en direction de Toussaint-Sainte-Peur.","type":"dialogue"},"91":{"next_id":"94","type":"goto"},"94":{"character":"Léonnie","next_id":"95","replacements":[],"text":"Mon dieu... Qu'ont-elles fait là bas... Que leur est-il arrivé ?!","type":"dialogue"},"95":{"condition":null,"next_id":"96","next_id_after":"","replacements":[],"responses":["95","98"],"text":"Tomber dans les citrouilles","type":"response"},"96":{"character":"","next_id":"97","replacements":[],"text":"Allons Léonnie... Courage, ce n'est pas le moment de faillir !","type":"dialogue"},"97":{"next_id":"94","type":"goto"},"98":{"condition":null,"next_id":"99","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"99":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"100","type":"mutation"}},"titles":{"01 Start":"1","02 Waiting":"12","03 Carrefour":"94","03 Pumpkins":"53","04 Quiproquo":"104","2.5 Reflexion":"83"}}