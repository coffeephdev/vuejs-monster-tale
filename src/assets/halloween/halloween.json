{"lines":{"10":{"next_id":"13","type":"goto"},"101":{"mutation":{"lhs_args":["\"ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"102","type":"mutation"},"102":{"character":"","next_id":"103","replacements":[],"text":"Devant Léonnie se dresse une petite apocalypse.","type":"dialogue"},"103":{"character":"","next_id":"104","replacements":[],"text":"Des citrouilles partout ! Dans la rue, par les fenêtres...","type":"dialogue"},"104":{"character":"","next_id":"105","replacements":[],"text":"Les cucurbitacés semble s'être répamdus dans toute la ville !","type":"dialogue"},"105":{"character":"Léonnie","next_id":"106","replacements":[],"text":"Oh là là... Le Fantôme ne mentait pas !","type":"dialogue"},"106":{"character":"Léonnie","next_id":"107","replacements":[],"text":"Je peux choisir d'hyperventiler, ou bien réfléchir au problème...","type":"dialogue"},"107":{"character":"Léonnie","next_id":"108","replacements":[],"text":"Pourquoi pas les deux à la fois ? Non, voyons, respirons un bon coup.","type":"dialogue"},"108":{"character":"Léonnie","next_id":"109","replacements":[],"text":"Fantôme a dit qu'il avait du mal à se souvenir de quelque chose.","type":"dialogue"},"109":{"character":"Léonnie","next_id":"110","replacements":[],"text":"Donc, on sait qu'il s'est passé quelque chose !","type":"dialogue"},"110":{"character":"Léonnie","next_id":"111","replacements":[],"text":"Je connais deux zigotos qui auraient probablement des réponses.","type":"dialogue"},"111":{"character":"Léonnie","next_id":"112","replacements":[],"text":"Je peux aller voir le Maire, toujours en train de manigancer quelque chose.","type":"dialogue"},"112":{"character":"Léonnie","next_id":"113","replacements":[],"text":"Et aussi Vampire, pas le dernier pour semer la zizanie !","type":"dialogue"},"113":{"character":"Léonnie","next_id":"114","replacements":[],"text":"Je vais commencer par...","type":"dialogue"},"114":{"condition":null,"next_id":"115","next_id_after":"","replacements":[],"responses":["114","116"],"text":"Aller voir le Maire","type":"response"},"115":{"next_id":"120","type":"goto"},"116":{"condition":null,"next_id":"117","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"117":{"next_id":"183","type":"goto"},"120":{"mutation":{"lhs_args":["\"ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"121","type":"mutation"},"121":{"mutation":{"lhs_args":["\"maire 40 20 0.7\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"122","type":"mutation"},"122":{"condition":{"lhs":"hasMaireIndice","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"false"}],"rhs_type":"scalar"},"next_conditional_id":"137","next_id":"123","next_id_after":"139","type":"condition"},"123":{"character":"","next_id":"124","replacements":[],"text":"Le Maire du village est un joyeux luron. Parfois trop joyeux.","type":"dialogue"},"124":{"character":"Maire","next_id":"125","replacements":[],"text":"Ah Lélé ! Ca fait plaisir de te voir !","type":"dialogue"},"125":{"character":"","next_id":"126","replacements":[],"text":"Il a une facheuse tendance à donner des surnoms éclatés aux gens.","type":"dialogue"},"126":{"character":"Léonnie","next_id":"127","replacements":[],"text":"Haha, oui... Bonjour Maire.","type":"dialogue"},"127":{"character":"Maire","next_id":"128","replacements":[],"text":"Dis-donc Ninie, vous avez eu la main lourde cette année sur la potion !","type":"dialogue"},"128":{"character":"","next_id":"129","replacements":[],"text":"Léonnie fulmine.","type":"dialogue"},"129":{"character":"Maire","next_id":"130","replacements":[],"text":"Vous savez quoi ? Si vous réglez ça avant Halloween...","type":"dialogue"},"13":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"false"}],"rhs_type":"scalar"},"next_conditional_id":"15","next_id":"14","next_id_after":"19","type":"condition"},"130":{"character":"Maire","next_id":"131","replacements":[],"text":"Je vous invite au resto ! Qu'est-ce que vous en dites ? Ca ne se refuse pas !","type":"dialogue"},"131":{"character":"Léonnie","next_id":"132","replacements":[],"text":"(Je veux disparaître...)","type":"dialogue"},"132":{"character":"Léonnie","next_id":"133","replacements":[],"text":"Ou alors, on disait qu'il n'y aurait pas de resto en échange ? Hein ?","type":"dialogue"},"133":{"character":"Maire","next_id":"134","replacements":[],"text":"Haha, Lénou quel humour ! J'adore !","type":"dialogue"},"134":{"character":"Léonnie","next_id":"135","replacements":[],"text":"(On règlera ça plus tard...)","type":"dialogue"},"135":{"character":"Léonnie","next_id":"136","replacements":[],"text":"Passons, j'aurais voulu vous poser quelques question m'sieur le Maire.","type":"dialogue"},"136":{"next_id":"147","type":"goto"},"137":{"condition":null,"next_conditional_id":"139","next_id":"138","next_id_after":"139","type":"condition"},"138":{"character":"Maire","next_id":"139","replacements":[],"text":"J'ai déjà tout dit ptn...","type":"dialogue"},"139":{"condition":null,"next_id":"140","next_id_after":"","replacements":[],"responses":["139","142"],"text":"Retourner voir Fantôme","type":"response"},"14":{"character":"","next_id":"19","replacements":[],"text":"Mais rien ne presse...","type":"dialogue"},"140":{"mutation":{"lhs_args":["\"maire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"141","type":"mutation"},"141":{"next_id":"200","type":"goto"},"142":{"condition":null,"next_id":"143","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"143":{"mutation":{"lhs_args":["\"maire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"144","type":"mutation"},"144":{"next_id":"183","type":"goto"},"147":{"character":"Maire","next_id":"148","replacements":[],"text":"Mais bien sûr Nilou ! Pour vous j'ai toujours le temps !","type":"dialogue"},"148":{"condition":null,"next_id":"149","next_id_after":"","replacements":[],"responses":["148","153","177"],"text":"Parler beau temps","type":"response"},"149":{"character":"Léonnie","next_id":"150","replacements":[],"text":"Beau temps n'est-ce pas ? L'Automne, le soleil...","type":"dialogue"},"15":{"condition":null,"next_conditional_id":"19","next_id":"16","next_id_after":"19","type":"condition"},"150":{"character":"Maire","next_id":"151","replacements":[],"text":"Les citrouilles qui se baladent... Vous êtes sûre de ne rien pouvoir faire à ce sujet ?","type":"dialogue"},"151":{"character":"Léonnie","next_id":"152","replacements":[],"text":"Oui, bon... Parlons d'autre chose.","type":"dialogue"},"152":{"next_id":"147","type":"goto"},"153":{"condition":null,"next_id":"154","next_id_after":"","replacements":[],"responses":[],"text":"Parler voyages","type":"response"},"154":{"character":"Léonnie","next_id":"155","replacements":[],"text":"J'ai entendu dire que vous étiez féru de voyages !","type":"dialogue"},"155":{"character":"Maire","next_id":"156","replacements":[],"text":"Ah oui ? Qui vous en a parlé ?","type":"dialogue"},"156":{"character":"Léonnie","next_id":"157","replacements":[],"text":"Vous, à chaque fois que je vous croise. Vous parlez beaucoup de vous.","type":"dialogue"},"157":{"character":"Maire","next_id":"158","replacements":[],"text":"Haha ! Je pourrais croire que vous vous lassez de nos conversations !","type":"dialogue"},"158":{"character":"Maire","next_id":"159","replacements":[],"text":"Heureusement que je vous connais.","type":"dialogue"},"159":{"character":"Léonnie","next_id":"160","replacements":[],"text":"Oui, heureusement...","type":"dialogue"},"16":{"character":"","next_id":"17","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"160":{"character":"Léonnie","next_id":"161","replacements":[],"text":"Vous aimez loger chez l'habitant, me semble-t-il ?","type":"dialogue"},"161":{"character":"Maire","next_id":"162","replacements":[],"text":"Rien de mieux pour apprécier pleinement  la région que l'on visite !","type":"dialogue"},"162":{"character":"Léonnie","next_id":"163","replacements":[],"text":"Et la prochaine fois, vous pourriez me demander avant de rentrer chez moi ?","type":"dialogue"},"163":{"character":"Maire","next_id":"164","replacements":[],"text":"Que ?! Enfin Lélé... On se connait mieux que ça !","type":"dialogue"},"164":{"character":"Léonnie","next_id":"165","replacements":[],"text":"Vous jurez ne pas être venu chez moi pendant mon absence ?","type":"dialogue"},"165":{"character":"Maire","next_id":"166","replacements":[],"text":"Alors là, croix de bois croix de fer, si je mens je vais en enfer !","type":"dialogue"},"166":{"character":"Maire","next_id":"167","replacements":[],"text":"Bon, étant un squelette ça ne m'engage pas trop, mais ma parole est ma parole !","type":"dialogue"},"167":{"condition":null,"next_id":"168","next_id_after":"173","replacements":[],"responses":["167","170"],"text":"S'excuser","type":"response"},"168":{"character":"Léonnie","next_id":"169","replacements":[],"text":"Très bien, je vous crois... Acceptez mes excuses.","type":"dialogue"},"169":{"character":"Maire","next_id":"173","replacements":[],"text":"Haha ! Ce n'est rien. C'est n'est pas votre faute.","type":"dialogue"},"17":{"condition":null,"next_id":"18","next_id_after":"18","replacements":[],"responses":["17"],"text":"Aller voir les citrouilles","type":"response"},"170":{"condition":null,"next_id":"171","next_id_after":"173","replacements":[],"responses":[],"text":"Pester","type":"response"},"171":{"character":"Léonnie","next_id":"172","replacements":[],"text":"Mais JPP","type":"dialogue"},"172":{"character":"Maire","next_id":"173","replacements":[],"text":"Voyons Ninie, j'ai mes défauts mais je n'aime pas mentir. Et d'ailleurs...","type":"dialogue"},"173":{"character":"Maire","next_id":"174","replacements":[],"text":"Quelqu'un est effectivement passé chez vous.","type":"dialogue"},"174":{"character":"Léonnie","next_id":"175","replacements":[],"text":"Comment ?! Qui donc ??","type":"dialogue"},"175":{"mutation":{"lhs_args":["\"hasMaireIndice\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"176","type":"mutation"},"176":{"character":"Maire","next_id":"","replacements":[],"text":"Notre ami aux dents longues ! Je ne sais pas quel projet menait-il.","type":"dialogue"},"177":{"condition":null,"next_id":"178","next_id_after":"","replacements":[],"responses":[],"text":"Parler tendances","type":"response"},"178":{"mutation":{"lhs_args":["\"maire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"179","type":"mutation"},"179":{"next_id":"120","type":"goto"},"18":{"next_id":"30","type":"goto"},"183":{"mutation":{"lhs_args":["\"ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"184","type":"mutation"},"184":{"mutation":{"lhs_args":["\"vampire 40 20 0.7\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"185","type":"mutation"},"185":{"condition":{"lhs":"hasVampireIndice","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"false"}],"rhs_type":"scalar"},"next_conditional_id":"190","next_id":"186","next_id_after":"192","type":"condition"},"186":{"condition":null,"next_id":"187","next_id_after":"191","replacements":[],"responses":["186"],"text":"Apprendre indice Vampire","type":"response"},"187":{"mutation":{"lhs_args":["\"hasVampireIndice\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"188","type":"mutation"},"188":{"mutation":{"lhs_args":["\"vampire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"189","type":"mutation"},"189":{"next_id":"183","type":"goto"},"19":{"condition":null,"next_id":"20","next_id_after":"27","replacements":[],"responses":["19","26"],"text":"Boire une lampée","type":"response"},"190":{"condition":null,"next_conditional_id":"192","next_id":"191","next_id_after":"192","type":"condition"},"191":{"character":"Vampire","next_id":"192","replacements":[],"text":"J'ai déjà tout dit ptn...","type":"dialogue"},"192":{"condition":null,"next_id":"193","next_id_after":"","replacements":[],"responses":["192","195"],"text":"Retourner voir Fantôme","type":"response"},"193":{"mutation":{"lhs_args":["\"vampire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"194","type":"mutation"},"194":{"next_id":"200","type":"goto"},"195":{"condition":null,"next_id":"196","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Maire","type":"response"},"196":{"mutation":{"lhs_args":["\"vampire\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"197","type":"mutation"},"197":{"next_id":"120","type":"goto"},"2":{"character":"","next_id":"3","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"20":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"21","type":"mutation"},"200":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"201","type":"mutation"},"201":{"mutation":{"lhs_args":["\"fantome 30 20 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"202","type":"mutation"},"202":{"character":"Fantôme","next_id":"203","replacements":[],"text":"\"Bouh !\" mdr.","type":"dialogue"},"203":{"character":"Léonnie","next_id":"204","replacements":[],"text":"ptn t con c abusé","type":"dialogue"},"204":{"condition":null,"next_id":"205","next_id_after":"","replacements":[],"responses":["204"],"text":"Go boire la popo","type":"response"},"205":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"206","type":"mutation"},"206":{"next_id":"209","type":"goto"},"209":{"mutation":{"lhs_args":["\"attaque-ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"210","type":"mutation"},"21":{"character":"","next_id":"22","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"210":{"character":"","next_id":"211","replacements":[],"text":"miam miam la popo 2 rockent","type":"dialogue"},"211":{"condition":null,"next_id":"212","next_id_after":"","replacements":[],"responses":["211"],"text":"Go combat finalent","type":"response"},"212":{"next_id":"215","type":"goto"},"215":{"mutation":{"lhs_args":["\"leonnie-rap-ending\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"216","type":"mutation"},"216":{"character":"","next_id":"","replacements":[],"text":"mdr gg","type":"dialogue"},"22":{"character":"","next_id":"23","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"23":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"24","type":"mutation"},"24":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"25","type":"mutation"},"25":{"next_id":"13","type":"goto"},"26":{"condition":null,"next_id":"27","next_id_after":"27","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"27":{"next_id":"30","type":"goto"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"30":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"31","type":"mutation"},"31":{"character":"","next_id":"32","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"32":{"character":"","next_id":"33","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"33":{"character":"Léonnie","next_id":"34","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"34":{"character":"Léonnie","next_id":"35","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"35":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"36","type":"mutation"},"36":{"character":"Fantôme","next_id":"37","replacements":[],"text":"Oh là là...","type":"dialogue"},"37":{"character":"Léonnie","next_id":"38","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"38":{"character":"Fantôme","next_id":"39","replacements":[],"text":"Je... Je crois avoir...","type":"dialogue"},"39":{"character":"Fantôme","next_id":"40","replacements":[],"text":"Ah je ne sais plus!... Ma mémoire, elle disparait...","type":"dialogue"},"4":{"character":"","next_id":"5","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"40":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"41","type":"mutation"},"41":{"character":"Léonnie","next_id":"42","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"42":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"43","type":"mutation"},"43":{"character":"Fantôme","next_id":"44","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"44":{"character":"Léonnie","next_id":"45","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller)","type":"dialogue"},"45":{"character":"Léonnie","next_id":"46","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"46":{"character":"Léonnie","next_id":"47","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"47":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"48","type":"mutation"},"48":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"49","type":"mutation"},"49":{"character":"Fantôme","next_id":"50","replacements":[],"text":"Très bien, très bien ! Tout ce dont je me rappelle...","type":"dialogue"},"5":{"character":"","next_id":"6","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"50":{"character":"Fantôme","next_id":"51","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"51":{"character":"Léonnie","next_id":"52","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"52":{"character":"Fantôme","next_id":"53","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"53":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"54","type":"mutation"},"54":{"character":"Léonnie","next_id":"55","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"55":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"56","type":"mutation"},"56":{"character":"Fantôme","next_id":"57","replacements":[],"text":"Elles sont allées vers la ville... Il me semble ?","type":"dialogue"},"57":{"character":"Fantôme","next_id":"58","replacements":[],"text":"J'aimerais t'aider plus, je te jure ! Seulement ma mémoire...","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Fantôme","next_id":"60","replacements":[],"text":"C'est comme si elle s'effaçait.","type":"dialogue"},"6":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"7","type":"mutation"},"60":{"character":"Léonnie","next_id":"61","replacements":[],"text":"Nous voilà dans de beaux draps... Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"61":{"condition":null,"next_id":"62","next_id_after":"","replacements":[],"responses":["61","72","96"],"text":"Inspecter le champ","type":"response"},"62":{"character":"Léonnie","next_id":"63","replacements":[],"text":"Peut-être qu'il reste quelque chose sur place qui pourrait m'éclairer !","type":"dialogue"},"63":{"character":"Léonnie","next_id":"64","replacements":[],"text":"Certaines citrouilles n'ont pas bougé... Ca me fera des graines et de la tisane, au moins !","type":"dialogue"},"64":{"character":"Léonnie","next_id":"65","replacements":[],"text":"Tiens, c'est bizarre...","type":"dialogue"},"65":{"character":"","next_id":"66","replacements":[],"text":"Une citrouille semblant s'être déplacée, n'est cependant pas arrivée en ville.","type":"dialogue"},"66":{"character":"","next_id":"67","replacements":[],"text":"Dégagée de ses racines, elle a l'air d'avoir mordu un...","type":"dialogue"},"67":{"character":"Léonnie","next_id":"68","replacements":[],"text":"...mouchoir ? Mais qu'est-ce qu'un mouchoir fait ici ?!","type":"dialogue"},"68":{"character":"Léonnie","next_id":"69","replacements":[],"text":"Il est brodé, mais je ne reconnais pas la signature.","type":"dialogue"},"69":{"character":"Léonnie","next_id":"70","replacements":[],"text":"Brave citrouille, tu as voulu défendre le champ ? Quelle mauvaise graine a piqué les autres...","type":"dialogue"},"7":{"character":"","next_id":"8","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"70":{"character":"Léonnie","next_id":"71","replacements":[],"text":"Allons voir ça de plus près !","type":"dialogue"},"71":{"next_id":"101","type":"goto"},"72":{"condition":null,"next_id":"73","next_id_after":"","replacements":[],"responses":[],"text":"Inspecter le chaudron","type":"response"},"73":{"character":"","next_id":"74","replacements":[],"text":"Il ne semble pas à Léonnie avoir raté la recette mais...","type":"dialogue"},"74":{"character":"Léonnie","next_id":"75","replacements":[],"text":"Mieux vaut vérifier deux fois, pas vrai ?","type":"dialogue"},"75":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"76","type":"mutation"},"76":{"character":"Léonnie","next_id":"77","replacements":[],"text":"Le chaudron est telle que je l'ai laissé.","type":"dialogue"},"77":{"character":"Léonnie","next_id":"78","replacements":[],"text":"Peut-être que cela vient d'ailleurs ?","type":"dialogue"},"78":{"condition":null,"next_id":"79","next_id_after":"97","replacements":[],"responses":["78","87"],"text":"Inspecter le sol","type":"response"},"79":{"mutation":{"lhs_args":["\"foundGarlic\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"80","type":"mutation"},"8":{"character":"","next_id":"9","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"80":{"character":"Léonnie","next_id":"81","replacements":[],"text":"Mais, il y a une étiquette, là !","type":"dialogue"},"81":{"character":"","next_id":"82","replacements":[],"text":"Sur l'étiquette, est écrit \"Ail\"...","type":"dialogue"},"82":{"character":"Léonnie","next_id":"83","replacements":[],"text":"Quelqu'un a imité mon écriture ? Ca veut dire que j'ai échangé un des ingrédients !","type":"dialogue"},"83":{"character":"Léonnie","next_id":"84","replacements":[],"text":"J'imagine que j'ai du mettre autre chose à la place de l'ail.","type":"dialogue"},"84":{"character":"Léonnie","next_id":"85","replacements":[],"text":"Les citrouilles n'ont pas apprécié ! Quel cauchemar, et Halloween qui approche.","type":"dialogue"},"85":{"character":"Léonnie","next_id":"86","replacements":[],"text":"Je ne sais pas qui m'a joué ce tour, mais il va voir de quoi se chauffe une sorcière !","type":"dialogue"},"86":{"next_id":"101","type":"goto"},"87":{"condition":null,"next_id":"88","next_id_after":"97","replacements":[],"responses":[],"text":"Inspecter l'étagère","type":"response"},"88":{"mutation":{"lhs_args":["\"foundGarlic\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"89","type":"mutation"},"89":{"character":"","next_id":"90","replacements":[],"text":"Tous les ingrédients semblent impecablement rangés sur l'étagère.","type":"dialogue"},"9":{"character":"","next_id":"10","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"90":{"character":"Léonnie","next_id":"91","replacements":[],"text":"Tous... Sauf ce pot !","type":"dialogue"},"91":{"character":"Léonnie","next_id":"92","replacements":[],"text":"Il n'est pas rangé à sa place. De l'oignon en poudre ?","type":"dialogue"},"92":{"character":"Léonnie","next_id":"93","replacements":[],"text":"Je n'en ai pas besoin pour la recette. Il était à la place de...","type":"dialogue"},"93":{"character":"Léonnie","next_id":"94","replacements":[],"text":"Mais où est l'ail semoule ?!","type":"dialogue"},"94":{"character":"Léonnie","next_id":"95","replacements":[],"text":"Je vois. Quelqu'un a décidé de jouer avec moi. Voyons comment lui renvoyer l'ascenseur !","type":"dialogue"},"95":{"next_id":"101","type":"goto"},"96":{"condition":null,"next_id":"97","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"97":{"character":"","next_id":"98","replacements":[],"text":"Léonnie, furibonde, part d'un pas décidé vers la ville pour tirer cette affaire au clair.","type":"dialogue"},"98":{"next_id":"101","type":"goto"}},"titles":{"01 Start":"2","02 Waiting":"13","03 Pumpkins":"30","04 City":"101","05 Fantome":"200","05 Maire":"120","05 QuestionsMaire":"147","05 Vampire":"183","06 Choix Potion":"209","07 Combat Final Rock":"215"}}