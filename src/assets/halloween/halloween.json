{"lines":{"1":{"character":"","next_id":"2","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"12":{"condition":{"lhs":"hasCheckCauldron","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"28","next_id":"13","next_id_after":"28","type":"condition"},"13":{"character":"","next_id":"14","replacements":[],"text":"Peut-être qu'il faudrait y aller maintenant...","type":"dialogue"},"14":{"condition":null,"next_id":"15","next_id_after":"29","replacements":[],"responses":["14","26"],"text":"Relire la recette","type":"response"},"15":{"character":"Léonnie","next_id":"16","replacements":[],"text":"Je l'ai mise quelque part...","type":"dialogue"},"16":{"character":"","next_id":"17","replacements":[],"text":"Léonnie n'est pas très organisée","type":"dialogue"},"17":{"character":"Léonnie","next_id":"18","replacements":[],"text":"Dis-donc ! Ca suffit ! Alors...","type":"dialogue"},"18":{"character":"Léonnie","next_id":"19","replacements":[],"text":"La recette de ma fameuse potion revigorante pour citrouille !","type":"dialogue"},"19":{"character":"Léonnie","next_id":"20","replacements":[],"text":"Dans la famille, nous faisons reluire les citrouilles de mère en fille depuis des générations !","type":"dialogue"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"character":"Léonnie","next_id":"21","replacements":[],"text":"Pour qu'elles soient reluisantes et dodues, il nous faut :","type":"dialogue"},"21":{"character":"Léonnie","next_id":"22","replacements":[],"text":"Une peau de renard crevé sous les roues d'un carosse de Maraine-la-bonne-fée. Un peu triste. Au moins, c'est pas perdu...","type":"dialogue"},"22":{"character":"Léonnie","next_id":"23","replacements":[],"text":"...Une fraise. J'aime les fraises. Et puis ça fait briller les cirtrouilles.","type":"dialogue"},"23":{"character":"Léonnie","next_id":"24","replacements":[],"text":"...Un gros triton réduit en poudre. Cueilli moi-même !","type":"dialogue"},"24":{"character":"Léonnie","next_id":"25","replacements":[],"text":"...et une queue de citrouille.","type":"dialogue"},"25":{"next_id":"12","type":"goto"},"26":{"condition":null,"next_id":"27","next_id_after":"29","replacements":[],"responses":[],"text":"Aller voir les citrouilles (pour de vrai)","type":"response"},"27":{"next_id":"50","type":"goto"},"28":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"38","next_id":"29","next_id_after":"","type":"condition"},"29":{"character":"","next_id":"30","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"condition":null,"next_id":"31","next_id_after":"39","replacements":[],"responses":["30","36"],"text":"Vérifier le feu sous le chaudron","type":"response"},"31":{"mutation":{"lhs_args":["\"hasCheckCauldron\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"32","type":"mutation"},"32":{"character":"Léonnie","next_id":"33","replacements":[],"text":"Non, c'est bon j'ai éteins le feu...","type":"dialogue"},"33":{"character":"","next_id":"34","replacements":[],"text":"Léonnie est enthousiasmée, mais peut-être un peu nerveuse","type":"dialogue"},"34":{"character":"Léonnie","next_id":"35","replacements":[],"text":"Mais ?! Mais non, pas du tout !","type":"dialogue"},"35":{"next_id":"12","type":"goto"},"36":{"condition":null,"next_id":"37","next_id_after":"39","replacements":[],"responses":[],"text":"Aller voir les citrouilles...?","type":"response"},"37":{"next_id":"50","type":"goto"},"38":{"condition":null,"next_conditional_id":"","next_id":"39","next_id_after":"","type":"condition"},"39":{"character":"","next_id":"40","replacements":[],"text":"Mais rien ne presse...","type":"dialogue"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"condition":null,"next_id":"41","next_id_after":"","replacements":[],"responses":["40","46"],"text":"Boire une lampée","type":"response"},"41":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"42","type":"mutation"},"42":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"43","type":"mutation"},"43":{"character":"","next_id":"44","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"44":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"45","type":"mutation"},"45":{"next_id":"12","type":"goto"},"46":{"condition":null,"next_id":"47","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"47":{"next_id":"50","type":"goto"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"51","type":"mutation"},"51":{"character":"","next_id":"52","replacements":[],"text":"Mais ?! Où sont elles passées, ce n'est pas possible ! Plus une courge à l'horizon !","type":"dialogue"},"52":{"character":"Léonnie","next_id":"53","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"53":{"character":"Léonnie","next_id":"54","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"54":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"55","type":"mutation"},"55":{"character":"Fantôme","next_id":"56","replacements":[],"text":"Oh là là...","type":"dialogue"},"56":{"character":"Léonnie","next_id":"57","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"57":{"character":"Fantôme","next_id":"58","replacements":[],"text":"Oh... On est dans de beaux draps...","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Léonnie","next_id":"60","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"61","type":"mutation"},"61":{"character":"Fantôme","next_id":"62","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"62":{"character":"Léonnie","next_id":"63","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller...)","type":"dialogue"},"63":{"character":"Léonnie","next_id":"64","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit pour vivre !","type":"dialogue"},"64":{"character":"Léonnie","next_id":"65","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"65":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"66","type":"mutation"},"66":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"67","type":"mutation"},"67":{"character":"Fantôme","next_id":"68","replacements":[],"text":"Très bien, très bien ! Ecoute, ça va te paraitre bizarre...","type":"dialogue"},"68":{"character":"Fantôme","next_id":"69","replacements":[],"text":"Ne te froisse pas... C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"69":{"character":"Léonnie","next_id":"70","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"70":{"character":"Fantôme","next_id":"71","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"71":{"character":"Léonnie","next_id":"72","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"72":{"character":"Fantôme","next_id":"73","replacements":[],"text":"Elles sont allées vers la ville... Je n'ose aller voir...","type":"dialogue"},"73":{"next_id":"76","type":"goto"},"76":{"character":"Léonnie","next_id":"77","replacements":[],"text":"Mon dieu... Qu'ont-elles fait là bas... Que leur est-il arrivé ?!","type":"dialogue"},"77":{"condition":null,"next_id":"78","next_id_after":"","replacements":[],"responses":["77","80"],"text":"Tomber dans les citrouilles","type":"response"},"78":{"character":"","next_id":"79","replacements":[],"text":"Allons Léonnie... Courage, ce n'est pas le moment de faillir !","type":"dialogue"},"79":{"next_id":"76","type":"goto"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"80":{"condition":null,"next_id":"81","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"81":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"82","type":"mutation"},"82":{"mutation":{"lhs_args":["\"\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"83","type":"mutation"},"83":{"next_id":"86","type":"goto"},"86":{"character":"","next_id":"","replacements":[],"text":"oh bah di dont les embrouillaminis","type":"dialogue"},"9":{"next_id":"12","type":"goto"}},"titles":{"01 Start":"1","02 Waiting":"12","03 Destination":"76","03 Pumpkins":"50","04 Quiproquo":"86"}}