"character":"","next_id":"308","replacements":[],"text":"Elle peut enfin mettre un terme à la zizanie qui règne à Toussaint-Sainte-Peur !","type":"dialogue"},"308":{"next_id":"366","type":"goto"},"309":{"condition":null,"next_conditional_id":"","next_id":"310","next_id_after":"","type":"condition"},"310":{"character":"Léonnie","next_id":"311","replacements":[],"text":"Si on fait le lien entre les deux...","type":"dialogue"},"311":{"character":"Fantôme","next_id":"312","replacements":[],"text":"Ooooh non, tu penses que c'est moi !","type":"dialogue"},"312":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"313","type":"mutation"},"313":{"character":"Léonnie","next_id":"314","replacements":[],"text":"Enfin, Fantôme, c'est logique, tout simplement logique !","type":"dialogue"},"314":{"mutation":{"lhs_args":["\"fantome 30 20 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"315","type":"mutation"},"315":{"character":"Fantôme","next_id":"316","replacements":[],"text":"Je te promets que ce n'est pas moi...","type":"dialogue"},"316":{"character":"Léonnie","next_id":"317","replacements":[],"text":"Je veux bien te croire, mais il me faudrait d'autres éléments, cher ami.","type":"dialogue"},"317":{"character":"Fantôme","next_id":"318","replacements":[],"text":"Tu sais, pendant ton enquête, j'ai un peu enquêté...","type":"dialogue"},"318":{"character":"Léonnie","next_id":"319","replacements":[],"text":"Tu as trouvé quelque chose ?","type":"dialogue"},"319":{"character":"Fantôme","next_id":"320","replacements":[],"text":"Je ne sais pas si ça peut aider mais...","type":"dialogue"},"32":{"mutation":{"lhs_args":[],"lhs_function":"remove_all_chars","lhs_type":"function"},"next_id":"33","type":"mutation"},"320":{"character":"Fantôme","next_id":"321","replacements":[],"text":"Il y avait de l'ail par terre...","type":"dialogue"},"321":{"condition":{"lhs":"foundGarlic","lhs_type":"scalar","operator":"==","rhs":[{"t