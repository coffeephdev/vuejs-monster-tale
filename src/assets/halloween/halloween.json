{"lines":{"1":{"character":"","next_id":"2","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"100":{"mutation":{"lhs_args":["\"ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"101","type":"mutation"},"101":{"character":"","next_id":"102","replacements":[],"text":"Devant Léonnie se dresse une petite apocalypse.","type":"dialogue"},"102":{"character":"","next_id":"103","replacements":[],"text":"Des citrouilles partout ! Dans la rue, par les fenêtres...","type":"dialogue"},"103":{"character":"","next_id":"104","replacements":[],"text":"Les cucurbitacés semble s'être répamdus dans toute la ville !","type":"dialogue"},"104":{"character":"Léonnie","next_id":"105","replacements":[],"text":"Oh là là... Le Fantôme ne mentait pas !","type":"dialogue"},"105":{"character":"Léonnie","next_id":"106","replacements":[],"text":"Je peux choisir d'hyperventiler, ou bien réfléchir au problème...","type":"dialogue"},"106":{"character":"Léonnie","next_id":"107","replacements":[],"text":"Pourquoi pas les deux à la fois ? Non, voyons, respirons un bon coup.","type":"dialogue"},"107":{"character":"Léonnie","next_id":"108","replacements":[],"text":"Fantôme a dit qu'il avait du mal à se souvenir de quelque chose.","type":"dialogue"},"108":{"character":"Léonnie","next_id":"109","replacements":[],"text":"Donc, on sait qu'il s'est passé quelque chose !","type":"dialogue"},"109":{"character":"Léonnie","next_id":"110","replacements":[],"text":"Je connais deux zigotos qui auraient probablement des réponses.","type":"dialogue"},"110":{"condition":null,"next_id":"111","next_id_after":"","replacements":[],"responses":["110","112"],"text":"Aller voir le Maire","type":"response"},"111":{"next_id":"116","type":"goto"},"112":{"condition":null,"next_id":"113","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"113":{"next_id":"133","type":"goto"},"1