,"next_id":"19","type":"mutation"},"19":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","rhs_type":""},"next_conditional_id":"26","next_id":"20","next_id_after":"26","type":"condition"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"character":"","next_id":"21","replacements":[],"text":"Décidément, c'est si bon...!","type":"dialogue"},"21":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"22","type":"mutation"},"22":{"character":"","next_id":"23","replacements":[],"text":"Bon, il faut y aller maintenant !","type":"dialogue"},"23":{"condition":null,"next_id":"24","next_id_after":"24","replacements":[],"responses":["23"],"text":"Aller voir les citrouilles","type":"response"},"24":{"next_id":"35","type":"goto"},"26":{"character":"","next_id":"27","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"27":{"character":"","next_id":"28","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"28":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"29","type":"mutation"},"29":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"30","type":"mutation"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"next_id":"12","type":"goto"},"31":{"condition":null,"next_id":"32","next_id_after":"32","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"32":{"next_id":"35","type":"goto"},"35":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"36","type":"mutation"},"36":{"character":"","next_id":"37","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"37":{"character":"","next_id":"38","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"38":{"character":"Léonnie","next_id":"39","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"39":{"character":"Léonnie","next_id":"40","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"41","type":"mutation"},"41":{"character":"Fantôme","next_id":"42","replacements":[],"text":"Oh là là...","type":"dialogue"},"42":{"character":"Léonnie","next_id":"43","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"43":{"character":"Fantôme","next_id":"44","replacements":[],"text":"Je... Je crois avoir...","type":"dialogue"},"44":{"character":"Fantôme","next_id":"45","replacements":[],"text":"Ah je ne sais plus!... Ma mémoire, elle disparait...","type":"dialogue"},"45":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"46","type":"mutation"},"46":{"character":"Léonnie","next_id":"47","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"47":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"48","type":"mutation"},"48":{"character":"Fantôme","next_id":"49","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"49":{"character":"Léonnie","next_id":"50","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller...)","type":"dialogue"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"character":"Léonnie","next_id":"51","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"51":{"character":"Léonnie","next_id":"52","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"52":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"53","type":"mutation"},"53":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"54","type":"mutation"},"54":{"character":"Fantôme","next_id":"55","replacements":[],"text":"Très bien, très bien ! Tout ce dont je me rappelle...","type":"dialogue"},"55":{"character":"Fantôme","next_id":"56","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"56":{"character":"Léonnie","next_id":"57","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"57":{"character":"Fantôme","next_id":"58","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Léonnie","next_id":"60","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"61","type":"mutation"},"61":{"character":"Fantôme","next_id":"62","replacements":[],"text":"Elles sont allées vers la ville... Il me semble ?","type":"dialogue"},"62":{"character":"Fantôme","next_id":"63","replacements":[],"text":"J'aimerais t'aider plus, je te jure ! Seulement ma mémoire...","type":"dialogue"},"63":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"64","type":"mutation"},"64":{"character":"Fantôme","next_id":"65","replacements":[],"text":"C'est comme si elle s'effaçait","type":"dialogue"},"65":{"character":"Léonnie","next_id":"66","replacements":[],"text":"Nous voilà dans de beaux draps... Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"66":{"character":"","next_id":"67","replacements":[],"text":"Léonnie, furibonde, part d'un pas décidé vers la ville pour tirer cette affaire au clair","type":"dialogue"},"67":{"condition":null,"next_id":"68","next_id_after":"","replacements":[],"responses":["67"],"text":"Aller voir en ville","type":"response"},"68":{"next_id":"71","type":"goto"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"71":{"mutation":{"lhs_args":["\"ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"72","type":"mutation"},"72":{"character":"","next_id":"73","replacements":[],"text":"Devant Léonnie se dresse une petite apocalypse","type":"dialogue"},"73":{"character":"Léonnie","next_id":"74","replacements":[],"text":"Oh là là... Le Fantôme ne mentait pas","type":"dialogue"},"74":{"character":"","next_id":"75","replacements":[],"text":"[Choix d'aller voir vampire ou maire]","type":"dialogue"},"75":{"condition":null,"next_id":"76","next_id_after":"","replacements":[],"responses":["75","77"],"text":"Aller voir le Maire","type":"response"},"76":{"next_id":"81","type":"goto"},"77":{"condition":null,"next_id":"78","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"78":{"next_id":"98","type":"goto"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","t