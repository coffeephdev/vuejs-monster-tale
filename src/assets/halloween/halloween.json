},"221":{"next_id":"127","type":"goto"},"224":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"225","type":"mutation"},"225":{"mutation":{"lhs_args":[],"lhs_function":"remove_all_chars","lhs_type":"function"},"next_id":"226","type":"mutation"},"226":{"mutation":{"lhs_args":["\"fantome 30 20 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"227","type":"mutation"},"227":{"character":"Fantôme","next_id":"228","replacements":[],"text":"C'est toi Léonnie ? Tu as appris quelque chose ?","type":"dialogue"},"228":{"condition":{"lhs_args":[],"lhs_function":"has_both_clues","lhs_type":"function","rhs_type":""},"next_conditional_id":"233","next_id":"229","next_id_after":"","type":"condition"},"229":{"character":"","next_id":"230","replacements":[],"text":"expliquer que c'est le fantome même s'il a perdu la mémoire","type":"dialogue"},"23":{"character":"","next_id":"24","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"230":{"character":"","next_id":"231","replacements":[],"text":"le fantome dévoile un bail qui permet de régler le souci genre la quantité utilisé","type":"dialogue"},"231":{"condition":null,"next_id":"232","next_id_after":"234","replacements":[],"responses":["231"],"text":"Go boire la popo","type":"response"},"232":{"next_id":"267","type":"goto"},"233":{"condition":{"lhs":"hasMaireIndice","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"251","next_id":"234","next_id_after":"","type":"condition"},"234":{"character":"Léonnie","next_id":"235","replacements":[],"text":"Dis-donc Fantôme...","type":"dialogue"},"235":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"236","type":"mutation"},"236":{"character":"Fantôme","next_id":"237","replacements":[],"text":"Oh non...","type":"dialogue"},"237":{"character":"Léonnie","next_id":"238","replacements":[],"text":"Il paraitrait que tu t'es introduit chez moi ! Tu aurais une explication ?","type":"dialogue"},"238":{"mutation":{"lhs_args":["\"fantome 35 20 0.7\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"239","type":"mutation"},"239":{"character":"Fantôme","next_id":"240","replacements":[],"text":"Vraiment ? J'ai fait ça ?","type":"dialogue"},"24":{"character":"","next_id":"25","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"240":{"character":"Léonnie","next_id":"241","replacements":[],"text":"Oui, c'est le Maire qui me l'a dit. Tu ne t'en rappelle vraiment pas ?","type":"dialogue"},"241":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"242","type":"mutation"},"242":{"character":"Fantôme","next_id":"243","replacements":[],"text":"Désolé, vraiment... Je te le dirais, je le jure !","type":"dialogue"},"243":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"244","type":"mutation"},"244":{"character":"","next_id":"245","replacements":[],"text":"Léonnie soupire","type":"dialogue"},"245":{"character":"Léonnie","next_id":"246","replacements":[],"text":"Très bien, j'imagine que je n'aime plus qu'à interroger Vampire, dans ce cas !","type":"dialogue"},"246":{"mutation":{"lhs_args":["\"fantome 30 20 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"247","type":"mutation"},"247":{"condition":null,"next_id":"248","next_id_after":"252","replacements":[],"responses":["247","249"],"text":"Aller voir Maire","type":"response"},"248":{"next_id":"127","type":"goto"},"249":{"condition":null,"next_id":"250","next_id_after":"252","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"25":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"26","type":"mutation"},"250":{"next_id":"207","type":"goto"},"251":{"condition":{"lhs":"hasVampireIndice","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"258","next_id":"252","next_id_after":"","type":"condition"},"252":{"character":"Fantôme","next_id":"253","replacements":[],"text":"Ha ptn sa degoute","type":"dialogue"},"253":{"character":"Léonnie","next_id":"254","replacements":[],"text":"oe","type":"dialogue"},"254":{"condition":null,"next_id":"255","next_id_after":"259","replacements":[],"responses":["254","256"],"text":"Aller voir Maire","type":"response"},"255":{"next_id":"127","type":"goto"},"256":{"condition":null,"next_id":"257","next_id_after":"259","replacements":[],"responses":[],"text":"Aller voir Vampire","type":"response"},"257":{"next_id":"207","type":"goto"},"258":{"condition":null,"next_conditional_id":"","next_id":"259","next_id_after":"","type":"condition"},"259":{"character":"Léonnie","next_id":"260","replacements":[],"text":"Non, toujours rien. Tu es sûr de ne rien te rappeler ?","type":"dialogue"},"26":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"27","type":"mutation"},"260":{"character":"Vampire","next_id":"261","replacements":[],"text":"Non... Seulement de m'être évanoui à un moment... Mmh...","type":"dialogue"},"261":{"condition":null,"next_id":"262","next_id_after":"","replacements":[],"responses":["261","263"],"text":"Aller voir Vampire","type":"response"},"262":{"next_id":"207","type":"goto"},"263":{"condition":null,"next_id":"264","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir Maire","type":"response"},"264":{"next_id":"127","type":"goto"},"267":{"mutation":{"lhs_args":[],"lhs_function":"remove_all_chars","lhs_type":"function"},"next_id":"268","type":"mutation"},"268":{"mutation":{"lhs_args":["\"attaque-ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"269","type":"mutation"},"269":{"character":"","next_id":"270","replacements":[],"text":"Dans la ville, certaines citrouilles colériques se sont rassemblées.","type":"dialogue"},"27":{"next_id":"14","type":"goto"},"270":{"character":"","next_id":"271","replacements":[],"text":"Elle forment un seul et même gigantesque cucurbitacé !","type":"dialogue"},"271":{"character":"Léonnie","next_id":"272","replacements":[],"text":"Oh non !","type":"dialogue"},"272":{"character":"Léonnie","next_id":"273","replacements":[],"text":"Il faut vraiment intervenir maintenant...","type":"dialogue"},"273":{"character":"Léonnie","next_id":"274","replacements":[],"text":"Sinon toute la ville va être rasée !","type":"dialogue"},"274":{"character":"Léonnie","next_id":"275","replacements":[],"text":"Heureusement, j'ai paré à toute éventualité !","type":"dialogue"},"275":{"character":"Léonnié","next_id":"276","replacements":[],"text":"Je vais boire ma potion de...","type":"dialogue"},"276":{"condition":null,"next_id":"277","next_id_after":"","replacements":[],"responses":["276"],"text":"Répartie","type":"response"},"277":{"next_id":"280","type":"goto"},"28":{"condition":null,"next_id":"29","next_id_after":"29","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"280":{"mutation":{"lhs_args":[],"lhs_function":"remove_all_chars","lhs_type":"function"},"next_id":"281","type":"mutation"},"281":{"mutation":{"lhs_args":["\"leonnie-rap-ending\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"282","type":"mutation"},"282":{"character":"","next_id":"283","replacements":[],"text":"Léonnie sort son micro ensorcelée, et commence à balancer punchline sur punchline à Citrouillezilla !","type":"dialogue"},"283":{"character":"Léonnie","next_id":"284","replacements":[],"text":"\"T'es pas la citrouille la plus arrosée du champ, à ta place je ficherais le camp !\"","type":"dialogue"},"284":{"character":"","next_id":"285","replacements":[],"text":"Citrouillezilla ne sait pas quoi répondre, elle se considère clashée !","type":"dialogue"},"285":{"character":"","next_id":"286","replacements":[],"text":"Elle s'effondre dans des hurlements infernaux.","type":"dialogue"},"286":{"character":"Léonnie","next_id":"","replacements":[],"text":"C'était pas de la tarte, mais on en est venu à bout !","type":"dialogue"},"29":{"next_id":"32","type":"goto"},"3":{"character":"","next_id":"4","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"32":{"mutation":{"lhs_args":[],"lhs_function":"remove_all_chars","lhs_type":"function"},"next_id":"33","type":"mutation"},"33":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"34","type":"mutation"},"34":{"character":"","next_id":"35","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"35":{"character":"","next_id":"36","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"36":{"character":"Léonnie","next_id":"37","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"37":{"character":"Léonnie","next_id":"38","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"38":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"39","type":"mutation"},"39":{"character":"Fantôme","next_id":"40","replacements":[],"text":"Oh là là...","type":"dialogue"},"4":{"character":"","next_id":"5","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"40":{"character":"Léonnie","next_id":"41","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"41":{"character":"Fantôme","next_id":"42","replacements":[],"text":"Je... Je crois avoir...","type":"dialogue"},"42":{"character":"Fantôme","next_id":"43","replacements":[],"text":"Ah je ne sais plus!... Ma mémoire, elle disparait...","type":"dialogue"},"43":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"44","type":"mutation"},"44":{"character":"Léonnie","next_id":"45","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"45":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"46","type":"mutation"},"46":{"character":"Fantôme","next_id":"47","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"47":{"character":"Léonnie","next_id":"48","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller)","type":"dialogue"},"48":{"character":"Léonnie","next_id":"49","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"49":{"character":"Léonnie","next_id":"50","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"5":{"character":"","next_id":"6","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"50":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"51","type":"mutation"},"51":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"52","type":"mutation"},"52":{"character":"Fantôme","next_id":"53","replacements":[],"text":"Très bien, très bien ! Tout ce dont je me rappelle...","type":"dialogue"},"53":{"character":"Fantôme","next_id":"54","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"54":{"character":"Léonnie","next_id":"55","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"55":{"character":"Fantôme","next_id":"56","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"56":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"57","type":"mutation"},"57":{"character":"Léonnie","next_id":"58","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Fantôme","next_id":"60","replacements":[],"text":"Elles sont allées vers la ville... Il me semble ?","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"60":{"character":"Fantôme","next_id":"61","replacements":[],"text":"J'aimerais t'aider plus, je te jure ! Seulement ma mémoire...","type":"dialogue"},"61":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"62","type":"mutation"},"62":{"character":"Fantôme","next_id":"63","replacements":[],"text":"C'est comme si elle s'effaçait.","type":"dialogue"},"63":{"character":"Léonnie","next_id":"64","replacements":[],"text":"Nous voilà dans de beaux draps... Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"64":{"condition":null,"next_id":"65","next_id_after":"","replacements":[],"responses":["64","75"],"text":"Inspecter le champ","type":"response"},"65":{"character":"Léonnie","next_id":"66","replacements":[],"text":"Peut-être qu'il reste quelque chose sur place qui pourrait m'éclairer !","type":"dialogue"},"66":{"character":"Léonnie","next_id":"67","replacements":[],"text":"Certaines citrouilles n'ont pas bougé... Ca me fera des graines et de la tisane, au moins !","type":"dialogue"},"67":{"character":"Léonnie","next_id":"68","replacements":[],"text":"Tiens, c'est bizarre...","type":"dialogue"},"68":{"character":"","next_id":"69","replacements":[],"text":"Une citrouille semblant s'être déplacée, n'est cependant pas arrivée en ville.","type":"dialogue"},"69":{"character":"","next_id":"70","replacements":[],"text":"Dégagée de ses racines, elle a l'air d'avoir mordu un...","type":"dialogue"},"7":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"8","type":"mutation"},"70":{"character":"Léonnie","next_id":"71","replacements":[],"text":"...mouchoir ? Mais qu'est-ce qu'un mouchoir fait ici ?!","type":"dialogue"},"71":{"character":"Léonnie","next_id":"72","replacements":[],"text":"Il est brodé, mais je ne reconnais pas la signature.","type":"dialogue"},"72":{"character":"Léonnie","next_id":"73","replacements":[],"text":"Brave citrouille, tu as voulu défendre le champ ? Quelle mauvaise graine a piqué les autres...","type":"dialogue"},"73":{"character":"Léonnie","next_id":"74","replacements":[],"text":"Allons voir ça de plus près !","type":"dialogue"},"74":{"next_id":"101","type":"goto"},"75":{"condition":null,"next_id":"76","next_id_after":"","replacements":[],"responses":[],"text":"Inspecter le chaudron","type":"response"},"76":{"character":"","next_id":"77","replacements":[],"text":"Il ne semble pas à Léonnie avoir raté la recette mais...","type":"dialogue"},"77":{"character":"Léonnie","next_id":"78","replacements":[],"text":"Mieux vaut vérifier deux fois, pas vrai ?","type":"dialogue"},"78":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"79","type":"mutation"},"79":{"character":"Léonnie","next_id":"80","replacements":[],"text":"Le chaudron est telle que je l'ai laissé.","type":"dialogue"},"8":{"character":"","next_id":"9","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"80":{"character":"Léonnie","next_id":"81","replacements":[],"text":"Peut-être que cela vient d'ailleurs ?","type":"dialogue"},"81":{"condition":null,"next_id":"82","next_id_after":"","replacements":[],"responses":["81","90"],"text":"Inspecter le sol","type":"response"},"82":{"mutation":{"lhs_args":["\"foundGarlic\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"83","type":"mutation"},"83":{"character":"Léonnie","next_id":"84","replacements":[],"text":"Mais, il y a une étiquette, là !","type":"dialogue"},"84":{"character":"","next_id":"85","replacements":[],"text":"Sur l'étiquette, est écrit \"Ail\"...","type":"dialogue"},"85":{"character":"Léonnie","next_id":"86","replacements":[],"text":"Quelqu'un a imité mon écriture ? Ca veut dire que j'ai échangé un des ingrédients !","type":"dialogue"},"86":{"character":"Léonnie","next_id":"87","replacements":[],"text":"J'imagine que j'ai du mettre autre chose à la place de l'ail.","type":"dialogue"},"87":{"character":"Léonnie","next_id":"88","replacements":[],"text":"Les citrouilles n'ont pas apprécié ! Quel cauchemar, et Halloween qui approche.","type":"dialogue"},"88":{"character":"Léonnie","next_id":"89","replacements":[],"text":"Je ne sais pas qui m'a joué ce tour, mais il va voir de quoi se chauffe une sorcière !","type":"dialogue"},"89":{"next_id":"101","type":"goto"},"9":{"character":"","next_id":"10","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"90":{"condition":null,"next_id":"91","next_id_after":"","replacements":[],"responses":[],"text":"Inspecter l'étagère","type":"response"},"91":{"mutation":{"lhs_args":["\"foundGarlic\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"92","type":"mutation"},"92":{"character":"","next_id":"93","replacements":[],"text":"Tous les ingrédients semblent impecablement rangés sur l'étagère.","type":"dialogue"},"93":{"character":"Léonnie","next_id":"94","replacements":[],"text":"Tous... Sauf ce pot !","type":"dialogue"},"94":{"character":"Léonnie","next_id":"95","replacements":[],"text":"Il n'est pas rangé à sa place. De l'oignon en poudre ?","type":"dialogue"},"95":{"character":"Léonnie","next_id":"96","replacements":[],"text":"Je n'en ai pas besoin pour la recette. Il était à la place de...","type":"dialogue"},"96":{"character":"Léonnie","next_id":"97","replacements":[],"text":"Mais où est l'ail semoule ?!","type":"dialogue"},"97":{"character":"Léonnie","next_id":"98","replacements":[],"text":"Je vois. Quelqu'un a décidé de jouer avec moi. Voyons comment lui renvoyer l'ascenseur !","type":"dialogue"},"98":{"next_id":"101","type":"goto"}},"titles":{"01 Start":"2","02 Waiting":"14","03 Pumpkins":"32","04 Before City":"101","04 City":"107","05 Fantome":"224","05 Maire":"127","05 QuestionsMaire":"155","05 Vampire":"207","06 Choix Potion":"267","07 Combat Final Rap":"280"}}