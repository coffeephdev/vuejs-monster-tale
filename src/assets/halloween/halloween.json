{"lines":{"1":{"character":"","next_id":"2","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"12":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"false"}],"rhs_type":"scalar"},"next_conditional_id":"14","next_id":"13","next_id_after":"16","type":"condition"},"13":{"character":"","next_id":"16","replacements":[],"text":"Mais rien ne presse...","type":"dialogue"},"14":{"condition":null,"next_conditional_id":"16","next_id":"15","next_id_after":"16","type":"condition"},"15":{"character":"","next_id":"16","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"16":{"condition":null,"next_id":"17","next_id_after":"31","replacements":[],"responses":["16","30"],"text":"Boire une lampée","type":"response"},"17":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"18","type":"mutation"},"18":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","rhs_type":""},"next_conditional_id":"24","next_id":"19","next_id_after":"24","type":"condition"},"19":{"character":"","next_id":"20","replacements":[],"text":"Décidément, c'est si bon...!","type":"dialogue"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"21","type":"mutation"},"21":{"character":"","next_id":"22","replacements":[],"text":"Bon, il faut y aller maintenant !","type":"dialogue"},"22":{"condition":null,"next_id":"23","next_id_after":"23","replacements":[],"responses":["22"],"text":"Aller voir les citrouilles","type":"response"},"23":{"next_id":"34","type":"goto"},"24":{"character":"","next_id":"25","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"25":{"character":"","next_id":"26","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"26":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"27","type":"mutation"},"27":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"29","type":"mutation"},"29":{"next_id":"12","type":"goto"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"condition":null,"next_id":"31","next_id_after":"31","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"31":{"next_id":"34","type":"goto"},"34":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"35","type":"mutation"},"35":{"character":"","next_id":"36","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"36":{"character":"","next_id":"37","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"37":{"character":"Léonnie","next_id":"38","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"38":{"character":"Léonnie","next_id":"39","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"39":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"40","type":"mutation"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"character":"Fantôme","next_id":"41","replacements":[],"text":"Oh là là...","type":"dialogue"},"41":{"character":"Léonnie","next_id":"42","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"42":{"character":"Fantôme","next_id":"43","replacements":[],"text":"Oh... Oh... On est dans de beaux draps...","type":"dialogue"},"43":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"44","type":"mutation"},"44":{"character":"Léonnie","next_id":"45","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"45":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"46","type":"mutation"},"46":{"character":"Fantôme","next_id":"47","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"47":{"character":"Léonnie","next_id":"48","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller...)","type":"dialogue"},"48":{"character":"Léonnie","next_id":"49","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"49":{"character":"Léonnie","next_id":"50","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"51","type":"mutation"},"51":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"52","type":"mutation"},"52":{"character":"Fantôme","next_id":"53","replacements":[],"text":"Très bien, très bien ! Ecoute, ça va te paraitre bizarre...","type":"dialogue"},"53":{"character":"Fantôme","next_id":"54","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"54":{"character":"Léonnie","next_id":"55","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"55":{"character":"Fantôme","next_id":"56","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"56":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"57","type":"mutation"},"57":{"character":"Léonnie","next_id":"58","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"58":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"59","type":"mutation"},"59":{"character":"Fantôme","next_id":"60","replacements":[],"text":"Elles sont allées vers la ville... Je n'ose aller voir...","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"character":"Léonnie","next_id":"","replacements":[],"text":"Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"9":{"next_id":"12","type":"goto"}},"titles":{"01 Start":"1","02 Waiting":"12","03 Pumpkins":"34"}}