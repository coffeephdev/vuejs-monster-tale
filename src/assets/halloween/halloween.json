47","type":"mutation"},"147":{"next_id":"116","type":"goto"},"15":{"character":"","next_id":"16","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"150":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"151","type":"mutation"},"151":{"mutation":{"lhs_args":["\"fantome 30 20 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"152","type":"mutation"},"152":{"character":"Fantôme","next_id":"153","replacements":[],"text":"\"Bouh !\" mdr.","type":"dialogue"},"153":{"character":"Léonnie","next_id":"154","replacements":[],"text":"ptn t con c abusé","type":"dialogue"},"154":{"condition":null,"next_id":"155","next_id_after":"","replacements":[],"responses":["154"],"text":"Go boire la popo","type":"response"},"155":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"156","type":"mutation"},"156":{"next_id":"159","type":"goto"},"159":{"mutation":{"lhs_args":["\"attaque-ville\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"160","type":"mutation"},"16":{"condition":null,"next_id":"17","next_id_after":"17","replacements":[],"responses":["16"],"text":"Aller voir les citrouilles","type":"response"},"160":{"character":"","next_id":"161","replacements":[],"text":"miam miam la popo 2 rockent","type":"dialogue"},"161":{"condition":null,"next_id":"162","next_id_after":"","replacements":[],"responses":["161"],"text":"Go combat finalent","type":"response"},"162":{"next_id":"165","type":"goto"},"165":{"mutation":{"lhs_args":["\"leonnie-rap-ending\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"166","type":"mutation"},"166":{"character":"","next_id":"","replacements":[],"text":"mdr gg","type":"dialogue"},"17":{"next_id":"29","type":"goto"},"18":{"condition":null,"next_id":"19","next_id_after":"26","replacements":[],"responses":["18","25"],"text":"Boire une lampée","type":"response"},"19":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"20","type":"mutation"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"character":"","next_id":"21","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"21":{"character":"","next_id":"22","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"22":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"23","type":"mutation"},"23":{"mutation":{"lhs":"toggle_state","lhs_type":"scalar","operator":"","rhs_type":"error"},"next_id":"24","type":"mutation"},"24":{"next_id":"12","type":"goto"},"25":{"condition":null,"next_id":"26","next_id_after":"26","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"26":{"next_id":"29","type":"goto"},"29":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"30","type":"mutation"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"character":"","next_id":"31","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"31":{"character":"","next_id":"32","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"32":{"character":"Léonnie","next_id":"33","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"33":{"character":"Léonnie","next_id":"34","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"34":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"35","type":"mutation"},"35":{"character":"Fantôme","next_id":"36","replacements":[],"text":"Oh là là...","type":"dialogue"},"36":{"character":"Léonnie","next_id":"37","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"37":{"character":"Fantôme","next_id":"38","replacements":[],"text":"Je... Je crois avoir...","type":"dialogue"},"38":{"character":"Fantôme","next_id":"39","replacements":[],"text":"Ah je ne sais plus!... Ma mémoire, elle disparait...","type":"dialogue"},"39":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"40","type":"mutation"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"character":"Léonnie","next_id":"41","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"41":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"42","type":"mutation"},"42":{"character":"Fantôme","next_id":"43","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"43":{"character":"Léonnie","next_id":"44","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller)","type":"dialogue"},"44":{"character":"Léonnie","next_id":"45","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"45":{"character":"Léonnie","next_id":"46","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"46":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"47","type":"mutation"},"47":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"48","type":"mutation"},"48":{"character":"Fantôme","next_id":"49","replacements":[],"text":"Très bien, très bien ! Tout ce dont je me rappelle...","type":"dialogue"},"49":{"character":"Fantôme","next_id":"50","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"character":"Léonnie","next_id":"51","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"51":{"character":"Fantôme","next_id":"52","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"52":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"53","type":"mutation"},"53":{"character":"Léonnie","next_id":"54","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"54":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"55","type":"mutation"},"55":{"character":"Fantôme","next_id":"56","replacements":[],"text":"Elles sont allées vers la ville... Il me semble ?","type":"dialogue"},"56":{"character":"Fantôme","next_id":"57","replacements":[],"text":"J'aimerais t'aider plus, je te jure ! Seulement ma mémoire...","type":"dialogue"},"57":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"58","type":"mutation"},"58":{"character":"Fantôme","next_id":"59","replacements":[],"text":"C'est comme si elle s'effaçait.","type":"dialogue"},"59":{"character":"Léonnie","next_id":"60","replacements":[],"text":"Nous voilà dans de beaux draps... Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"condition":null,"next_id":"61","next_id_after":"","replacements":[],"responses":["60","71","95"],"text":"Inspecter le champ","type":"response"},"61":{"character":"Léonnie","next_id":"62","replacements":[],"text":"Peut-être qu'il reste quelque chose sur place qui pourrait m'éclairer !","type":"dialogue"},"62":{"character":"Léonnie","next_id":"63","replacements":[],"text":"Certaines citrouilles n'ont pas bougé... Ca me fera des graines et de la tisane, au moins !","type":"dialogue"},"63":{"character":"Léonnie","next_id":"64","replacements":[],"text":"Tiens, c'est bizarre...","type":"dialogue"},"64":{"character":"","next_id":"65","replacements":[],"text":"Une citrouille semblant s'être déplacée, n'est cependant pas arrivée en ville.","type":"dialogue"},"65":{"character":"","next_id":"66","replacements":[],"text":"Dégagée de ses racines, elle a l'air d'avoir mordu un...","type":"dialogue"},"66":{"character":"Léonnie","next_id":"67","replacements":[],"text":"...mouchoir ? Mais qu'est-ce qu'un mouchoir fait ici ?!","type":"dialogue"},"67":{"character":"Léonnie","next_id":"68","replacements":[],"text":"Il est brodé, mais je ne reconnais pas la signature.","type":"dialogue"},"68":{"character":"Léonnie","next_id":"69","replacements":[],"text":"Brave citrouille, tu as voulu défendre le champ ? Quelle mauvaise graine a piqué les autres...","type":"dialogue"},"69":{"character":"Léonnie","next_id":"70","replacements":[],"text":"Allons voir ça de plus près !","type":"dialogue"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"70":{"next_id":"100","type":"goto"},"71":{"condition":null,"next_id":"72","next_id_after":"","replacements":[],"responses":[],"text":"Inspecter le chaudron","type":"response"},"72":{"character":"","next_id":"73","replacements":[],"text":"Il ne semble pas à Léonnie avoir raté la recette mais...","type":"dialogue"},"73":{"character":"Léonnie","next_id":"74","replacements":[],"text":"Mieux vaut vérifier deux fois, pas vrai ?","type":"dialogue"},"74":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"75","type":"mutation"},"75":{"character":"Léonnie","next_id":"76","replacements":[],"text":"Le chaudron est telle que je l'ai laissé.","type":"dialogue"},"76":{"character":"Léonnie","next_id":"77","replacements":[],"text":"Peut-être que cela vient d'ailleurs ?","type":"dialogue"},"77":{"condition":null,"next_id":"78","next_id_after":"96","replacements":[],"responses":["77","86"],"text":"Inspecter le sol","type":"response"},"78":{"mutation":{"lhs":"toggle_state","lhs_type":"scalar","operator":"","rhs_type":"error"},"next_id":"79","type":"mutation"},"79":{"character":"Léonnie","next_id":"80","replacements":[],"text":"Mais, il y a une étiquette, là !","type":"dialogue"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"80":{"character":"","next_id":"81","replacements":[],"text":"Sur l'étiquette, est écrit \"Ail\"...","type":"dialogue"},"81":{"character":"Léonnie","next_id":"82","replacements":[],"text":"Quelqu'un a imité mon écriture ? Ca veut dire que j'ai échangé un des ingrédients !","type":"dialogue"},"82":{"character":"Léonnie","next_id":"83","replacements":[],"text":"J'imagine que j'ai du mettre autre chose à la place de l'ail.","type":"dialogue"},"83":{"character":"Léonnie","next_id":"84","replacements":[],"text":"Les citrouilles n'ont pas apprécié ! Quel cauchemar, et Halloween qui approche.","type":"dialogue"},"84":{"character":"Léonnie","next_id":"85","replacements":[],"text":"Je ne sais pas qui m'a joué ce tour, mais il va voir de quoi se chauffe une sorcière !","type":"dialogue"},"85":{"next_id":"100","type":"goto"},"86":{"condition":null,"next_id":"87","next_id_after":"96","replacements":[],"responses":[],"text":"Inspecter l'étagère","type":"response"},"87":{"mutation":{"lhs":"toggle_state","lhs_type":"scalar","operator":"","rhs_type":"error"},"next_id":"88","type":"mutation"},"88":{"character":"","next_id":"89","replacements":[],"text":"Tous les ingrédients semblent impecablement rangés sur l'étagère.","type":"dialogue"},"89":{"character":"Léonnie","next_id":"90","replacements":[],"text":"Tous... Sauf ce pot !","type":"dialogue"},"9":{"next_id":"12","type":"goto"},"90":{"character":"Léonnie","next_id":"91","replacements":[],"text":"Il n'est pas rangé à sa place. De l'oignon en poudre ?","type":"dialogue"},"91":{"character":"Léonnie","next_id":"92","replacements":[],"text":"Je n'en ai pas besoin pour la recette. Il était à la place de...","type":"dialogue"},"92":{"character":"Léonnie","next_id":"93","replacements":[],"text":"Mais où est l'ail semoule ?!","type":"dialogue"},"93":{"character":"Léonnie","next_id":"94","replacements":[],"text":"Je vois. Quelqu'un a décidé de jouer avec moi. Voyons comment lui renvoyer l'ascenseur !","type":"dialogue"},"94":{"next_id":"100","type":"goto"},"95":{"condition":null,"next_id":"96","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"96":{"character":"","next_id":"97","replacements":[],"text":"Léonnie, furibonde, part d'un pas décidé vers la ville pour tirer cette affaire au clair.","type":"dialogue"},"97":{"next_id":"100","type":"goto"}},"titles":{"01 Start":"1","02 Waiting":"12","03 Pumpkins":"29","04 City":"100","05 Fantome":"150","05 Maire":"116","05 Vampire":"133","06 Choix Potion":"159","07 Combat Final Rock":"165"}}