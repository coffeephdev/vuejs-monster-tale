{"lines":{"1":{"character":"","next_id":"2","replacements":[],"text":"Léonnie la sorcière vit paisiblement dans la petite ville de Toussaint-Sainte-Peur.","type":"dialogue"},"100":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"101","type":"mutation"},"101":{"mutation":{"lhs_args":["\"\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"102","type":"mutation"},"102":{"next_id":"105","type":"goto"},"105":{"character":"","next_id":"","replacements":[],"text":"oh bah di dont les embrouillaminis","type":"dialogue"},"12":{"condition":{"lhs":"hasCheckCauldron","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"29","next_id":"13","next_id_after":"29","type":"condition"},"13":{"character":"","next_id":"14","replacements":[],"text":"Peut-être qu'il faudrait y aller maintenant...","type":"dialogue"},"14":{"condition":null,"next_id":"15","next_id_after":"30","replacements":[],"responses":["14","27"],"text":"Relire la recette","type":"response"},"15":{"mutation":{"lhs_args":["\"hasReadRecipy\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"16","type":"mutation"},"16":{"character":"Léonnie","next_id":"17","replacements":[],"text":"Je l'ai mise quelque part...","type":"dialogue"},"17":{"character":"","next_id":"18","replacements":[],"text":"Léonnie n'est pas très organisée","type":"dialogue"},"18":{"character":"Léonnie","next_id":"19","replacements":[],"text":"Dis-donc ! Ca suffit !\\n Alors...","type":"dialogue"},"19":{"character":"Léonnie","next_id":"20","replacements":[],"text":"La recette de ma fameuse potion revigorante pour citrouille !","type":"dialogue"},"2":{"character":"","next_id":"3","replacements":[],"text":"Sa spécialité ? Les potions !","type":"dialogue"},"20":{"character":"Léonnie","next_id":"21","replacements":[],"text":"Dans la famille, nous faisons briller les citrouilles de mère en fille depuis des générations !","type":"dialogue"},"21":{"character":"Léonnie","next_id":"22","replacements":[],"text":"Pour qu'elles soient reluisantes et dodues, il nous faut :","type":"dialogue"},"22":{"character":"Léonnie","next_id":"23","replacements":[],"text":"Une peau de renard crevé sous les roues d'un carosse de Maraine-la-bonne-fée. Un peu triste. Au moins, c'est pas perdu...","type":"dialogue"},"23":{"character":"Léonnie","next_id":"24","replacements":[],"text":"...Une fraise. J'aime les fraises. Et puis ça fait briller les cirtrouilles.","type":"dialogue"},"24":{"character":"Léonnie","next_id":"25","replacements":[],"text":"...Un gros triton réduit en poudre. Cueilli moi-même !","type":"dialogue"},"25":{"character":"Léonnie","next_id":"26","replacements":[],"text":"...et une queue de citrouille.","type":"dialogue"},"26":{"next_id":"12","type":"goto"},"27":{"condition":null,"next_id":"28","next_id_after":"30","replacements":[],"responses":[],"text":"Aller voir les citrouilles (pour de vrai)","type":"response"},"28":{"next_id":"54","type":"goto"},"29":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","operator":"==","rhs":[{"type":"value","value":"true"}],"rhs_type":"scalar"},"next_conditional_id":"41","next_id":"30","next_id_after":"","type":"condition"},"3":{"character":"","next_id":"4","replacements":[],"text":"Sur son petit cottage, se dresse une maison à pattes de poules, ainsi qu'un champ de citrouilles.","type":"dialogue"},"30":{"character":"","next_id":"31","replacements":[],"text":"Rien ne presse, donc...","type":"dialogue"},"31":{"condition":null,"next_id":"32","next_id_after":"42","replacements":[],"responses":["31","39"],"text":"Vérifier le feu sous le chaudron","type":"response"},"32":{"mutation":{"lhs_args":["\"hasCheckCauldron\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"33","type":"mutation"},"33":{"character":"Léonnie","next_id":"34","replacements":[],"text":"Non, c'est bon j'ai éteins le feu...","type":"dialogue"},"34":{"character":"Léonnie","next_id":"35","replacements":[],"text":"Tiens, j'ai renversé un pot ?","type":"dialogue"},"35":{"character":"","next_id":"36","replacements":[],"text":"Léonnie est enthousiasmée, mais peut-être un peu nerveuse","type":"dialogue"},"36":{"character":"Léonnie","next_id":"37","replacements":[],"text":"Mais ?! Mais non, pas du tout !","type":"dialogue"},"37":{"character":"Léonnie","next_id":"38","replacements":[],"text":"Peut-être un peu...","type":"dialogue"},"38":{"next_id":"12","type":"goto"},"39":{"condition":null,"next_id":"40","next_id_after":"42","replacements":[],"responses":[],"text":"Aller voir les citrouilles...?","type":"response"},"4":{"character":"","next_id":"5","replacements":[],"text":"Léonnie est très fière de ses citrouilles.","type":"dialogue"},"40":{"next_id":"54","type":"goto"},"41":{"condition":null,"next_conditional_id":"","next_id":"42","next_id_after":"","type":"condition"},"42":{"character":"","next_id":"43","replacements":[],"text":"Mais rien ne presse...","type":"dialogue"},"43":{"condition":null,"next_id":"44","next_id_after":"","replacements":[],"responses":["43","50"],"text":"Boire une lampée","type":"response"},"44":{"mutation":{"lhs_args":["\"hasDrinkTea\""],"lhs_function":"toggle_state","lhs_type":"function"},"next_id":"45","type":"mutation"},"45":{"mutation":{"lhs_args":["\"tea 30 10 0.6\""],"lhs_function":"spawn_item","lhs_type":"function"},"next_id":"46","type":"mutation"},"46":{"character":"","next_id":"47","replacements":[],"text":"Mmh, au bon goût de citrouille ! Sa tisane préférée.","type":"dialogue"},"47":{"character":"","next_id":"48","replacements":[],"text":"Cultivée à l'aide de la potion familiale, le goût est plus intense !","type":"dialogue"},"48":{"mutation":{"lhs_args":["\"tea\""],"lhs_function":"remove_item","lhs_type":"function"},"next_id":"49","type":"mutation"},"49":{"next_id":"12","type":"goto"},"5":{"mutation":{"lhs_args":["\"salon\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"6","type":"mutation"},"50":{"condition":null,"next_id":"51","next_id_after":"","replacements":[],"responses":[],"text":"Aller voir les citrouilles","type":"response"},"51":{"next_id":"54","type":"goto"},"54":{"mutation":{"lhs_args":["\"champ\""],"lhs_function":"change_backgrounds","lhs_type":"function"},"next_id":"55","type":"mutation"},"55":{"character":"","next_id":"56","replacements":[],"text":"Mais ?! Où sont elles passées ?!","type":"dialogue"},"56":{"character":"","next_id":"57","replacements":[],"text":"Plus une courge à l'horizon !","type":"dialogue"},"57":{"character":"Léonnie","next_id":"58","replacements":[],"text":"Ce n'est pas possible ?! Halloween est demain !","type":"dialogue"},"58":{"character":"Léonnie","next_id":"59","replacements":[],"text":" Comment vais-je faire ?!","type":"dialogue"},"59":{"mutation":{"lhs_args":["\"fantome 30 20 0.4\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"60","type":"mutation"},"6":{"character":"","next_id":"7","replacements":[],"text":"Buvant une infusion de ses cucurbitacés préférés, elle se prépare à sortir voir son potager.","type":"dialogue"},"60":{"character":"Fantôme","next_id":"61","replacements":[],"text":"Oh là là...","type":"dialogue"},"61":{"character":"Léonnie","next_id":"62","replacements":[],"text":"Fantôme, c'est toi ? Je t'en prie, as-tu vu quelque chose ?","type":"dialogue"},"62":{"character":"Fantôme","next_id":"63","replacements":[],"text":"Oh... Oh... On est dans de beaux draps...","type":"dialogue"},"63":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"64","type":"mutation"},"64":{"character":"Léonnie","next_id":"65","replacements":[],"text":"Enfin, ce n'est pas le moment de me laisser tomber, reviens !","type":"dialogue"},"65":{"mutation":{"lhs_args":["\"fantome 45 10 0.6\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"66","type":"mutation"},"66":{"character":"Fantôme","next_id":"67","replacements":[],"text":"Je... J'ai vu... Enfin... Il faisait nuit...","type":"dialogue"},"67":{"character":"Léonnie","next_id":"68","replacements":[],"text":"(Un jour, j'en ferais ma taie d'oreiller...)","type":"dialogue"},"68":{"character":"Léonnie","next_id":"69","replacements":[],"text":"Si je ne trouve pas de solution, je devrais me trouver un nouvel endroit où vivre !","type":"dialogue"},"69":{"character":"Léonnie","next_id":"70","replacements":[],"text":"Ce jour là, Fantôme, tu pourras dire adieu à l'adoucissant !","type":"dialogue"},"7":{"character":"","next_id":"8","replacements":[],"text":"Ayant répandu la veille sa fameuse potion revigorante pour citrouille, elle a hâte de voir le résultat.","type":"dialogue"},"70":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"71","type":"mutation"},"71":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"72","type":"mutation"},"72":{"character":"Fantôme","next_id":"73","replacements":[],"text":"Très bien, très bien ! Ecoute, ça va te paraitre bizarre...","type":"dialogue"},"73":{"character":"Fantôme","next_id":"74","replacements":[],"text":"C'est comme si tes citrouilles avaient pris vie, et s'étaient enfuies !","type":"dialogue"},"74":{"character":"Léonnie","next_id":"75","replacements":[],"text":"Quoi ?! Comment ça ? Mais où sont-elles allées ?","type":"dialogue"},"75":{"character":"Fantôme","next_id":"76","replacements":[],"text":"C'est pas moi...","type":"dialogue"},"76":{"mutation":{"lhs_args":["\"fantome\""],"lhs_function":"remove_char","lhs_type":"function"},"next_id":"77","type":"mutation"},"77":{"character":"Léonnie","next_id":"78","replacements":[],"text":"Voyons, ne te froisse pas ! Dis moi simplement où les trouver.","type":"dialogue"},"78":{"mutation":{"lhs_args":["\"fantome 35 20 0.70\""],"lhs_function":"spawn_char","lhs_type":"function"},"next_id":"79","type":"mutation"},"79":{"character":"Fantôme","next_id":"80","replacements":[],"text":"Elles sont allées vers la ville... Je n'ose aller voir...","type":"dialogue"},"8":{"character":"","next_id":"9","replacements":[],"text":"Leonnie est en effet chargé de décorer la ville pour Halloween, avec ses somptueuses citrouilles !","type":"dialogue"},"80":{"character":"Léonnie","next_id":"81","replacements":[],"text":"Mais qu'est-ce qui cloche à la fin ?","type":"dialogue"},"81":{"next_id":"84","type":"goto"},"84":{"character":"Léonnie","next_id":"85","replacements":[],"text":"Ca ne peut pas être ma potion, je la concocte chaque année...","type":"dialogue"},"85":{"condition":{"lhs":"hasDrinkTea","lhs_type":"scalar","rhs_type":""},"next_id":"86","next_id_after":"91","replacements":[],"responses":["85","90"],"text":"Réfléchir très fort","type":"response"},"86":{"character":"Léonnie","next_id":"87","replacements":[],"text":"Mmh... C'est vrai que la tisane avait un arrière-goût...","type":"dialogue"},"87":{"character":"Léonnie","next_id":"88","replacements":[],"text":"C'était donc ça, le goût intense ? Je me demande...","type":"dialogue"},"88":{"character":"","next_id":"89","replacements":[],"text":"Tout à ses réflexions, Léonnie se met en route en direction de Toussaint-Sainte-Peur.","type":"dialogue"},"89":{"next_id":"95","type":"goto"},"9":{"next_id":"12","type":"goto"},"90":{"condition":null,"next_id":"91","next_id_after":"91","replacements":[],"responses":[],"text":"Aller voir en ville","type":"response"},"91":{"character":"","next_id":"92","replacements":[],"text":"En proie au doute sur ses compétences, Léonnie file en direction de Toussaint-Sainte-Peur.","type":"dialogue"},"92":{"next_id":"95","type":"goto"},"95":{"character":"Léonnie","next_id":"96","replacements":[],"text":"Mon dieu... Qu'ont-elles fait là bas... Que leur est-il arrivé ?!","type":"dialogue"},"96":{"condition":null,"next_id":"97","next_id_after":"","replacements":[],"responses":["96","99"],"text":"Tomber dans les citrouilles","type":"response"},"97":{"character":"","next_id":"98","replacements":[],"text":"Allons Léonnie... Courage, ce n'est pas le moment de faillir !","type":"dialogue"},"98":{"next_id":"95","type":"goto"},"99":{"condition":null,"next_id":"100","next_id_after":"","replacements":[],"responses":[],"text":"Continuer vers la ville","type":"response"}},"titles":{"01 Start":"1","02 Waiting":"12","03 Carrefour":"95","03 Pumpkins":"54","04 Quiproquo":"105","2.5 Reflexion":"84"}}